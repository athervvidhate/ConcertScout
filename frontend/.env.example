# Where the browser reaches the FastAPI service. Public, never a secret.
# Vercel requires this and a real widget key in each deployed environment, including Preview.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Cloudflare Turnstile site key. This one is Cloudflare's always-pass test key, for local use only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Optional accounts. Leave both blank to turn sign-in off. These are the local stack's fixed
# values from `make supabase`; a deployment uses its Supabase project's URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
