# Ticketmaster Discovery API key. Required.
TM_KEY=
# Anthropic API key for the interpreter and the Poster's reasons. Required.
ANTHROPIC_API_KEY=
# Typesafe API key for Jev, which grades the shortlist. Required.
TYPESAFE_API_KEY=
# Geoapify API key for geocoding. Required.
GEOAPIFY_KEY=
# Last.fm API key, the fallback when ListenBrainz has no similar Artists. Optional.
LASTFM_KEY=
# Optional JamBase Developer key. Only the scheduler's /sync job calls its API.
JBD_API_KEY=
# How many days ahead the national JamBase catalog reaches, at most 180.
JAMBASE_DAYS=90
# Required for the scheduler's /warm and /sync routes.
CRON_SECRET=
# Redis connection for the shared cache.
REDIS_URL=redis://127.0.0.1:6379/0
# Browser origins allowed to call the API, as a JSON list.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Set to false to turn off Search at once. The home page keeps working.
SEARCH_ENABLED=true
# Searches each visitor gets an hour. Raise this for local work, where you are every visitor.
SEARCHES_PER_HOUR=10
# Cloudflare Turnstile secret. This one is Cloudflare's always-pass test key, for local use only.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# The header the host sets to the visitor's real address, such as x-real-ip. Leave empty locally.
CLIENT_IP_HEADER=

# Search reports reach the owner by email through Resend. Leave these blank to keep reports off.
RESEND_API_KEY=
# The address on the Resend account. Keep it here, never in the repo.
FEEDBACK_EMAIL=

# Optional invite-only Spotify connection. Leave these blank to keep it disabled.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Generate once: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep it private and stable: changing it invalidates stored connections.
SPOTIFY_ENCRYPTION_KEY=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback
