{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "functions": {
    "index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,evals/snapshots/**,evals/*.py,evals/*.html,evals/__pycache__/**,scripts/**,.env*,.pytest_cache/**,.ruff_cache/**}"
    }
  },
  "crons": [
    { "path": "/warm", "schedule": "0 23 * * *" },
    { "path": "/refresh-examples", "schedule": "0 0 * * *" },
    { "path": "/sync", "schedule": "0 10 * * *" },
    { "path": "/alerts", "schedule": "0 11 * * *" },
    { "path": "/sync-live-clips", "schedule": "0 9 * * 1" }
  ]
}
